<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.home.AnimatorTestActivity">


        <!--小图-->
        <androidx.cardview.widget.CardView
            android:id="@+id/cdView"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:cardCornerRadius="26dp"
            android:layout_width="345dp"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vTranslationY"
                android:layout_width="match_parent"
                android:layout_height="188dp">


                <Space
                    android:id="@+id/sIconMin"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="18dp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"/>

                <ImageView
                    android:id="@+id/ivMin1"
                    app:layout_constraintLeft_toLeftOf="@+id/sIconMin"
                    app:layout_constraintEnd_toEndOf="@+id/sIconMin"
                    app:layout_constraintTop_toTopOf="@+id/sIconMin"
                    app:layout_constraintBottom_toBottomOf="@+id/sIconMin"
                    android:src="@drawable/minimusiccover"
                    android:scaleType="centerCrop"
                    android:layout_width="64dp"
                    android:layout_height="64dp"/>

                <ImageView
                    android:id="@+id/ivMin2"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:src="@drawable/music_controlr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>



                <!--  =========================================================-->



                <ImageView
                    android:id="@+id/ivBig1"
                    android:src="@drawable/musiccover"
                    android:scaleType="centerCrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <ImageView
                    android:id="@+id/ivBig2"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="50dp"
                    android:alpha="0"
                    android:src="@drawable/musictitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>


                <LinearLayout
                    android:id="@+id/llAction"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:alpha="0"
                    android:layout_marginBottom="30dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp">


                    <ImageView
                        android:src="@drawable/previous"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:src="@drawable/play"
                        android:layout_marginHorizontal="40dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:src="@drawable/next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


    <View
        android:id="@+id/vBg2"
        app:layout_constraintTop_toBottomOf="@+id/cdView"
        android:layout_margin="10dp"
        android:background="@color/color_chat_bg"
        android:layout_width="match_parent"
        android:layout_height="188dp">

    </View>


</androidx.constraintlayout.widget.ConstraintLayout>